<% layout("/layouts/boilerplate.ejs") %>

<div class="container mt-5">
  <div class="card shadow-lg p-4 rounded-4">  
    <form action="/search" method="GET">
      <div class="row g-3 align-items-end">
        <div class="col-md-5">
          <label class="form-label">Pickup Location</label>
          <input 
            type="text" 
            name="from" 
            class="form-control rounded-3" 
            placeholder="Enter pickup location"
          >
        </div>
        <div class="col-md-5">
          <label class="form-label">Destination</label>
          <input 
            type="text" 
            name="to" 
            class="form-control rounded-3" 
            placeholder="Enter destination"
          >
        </div>
        <div class="col-md-2 d-grid">
          <button class="btn btn-dark rounded-3">
            Search
          </button>
        </div>

      </div>
    </form>

  </div>
</div>
<hr />

<div class="container mt-4">
  <div class="row">

    <% for (let ride_data of all_ride) { %>
      <% if(currTime < ride_data.departure_date_time && ride_data.seat > 0) { %>
      <div class="col-md-4 mb-4">
        <div class="card shadow-sm h-100 p-3">

          <h5 class="border-bottom pb-2">
            <b>Driver:</b> <%= ride_data.driver.username %>
          </h5>

          <p class="mb-1"><b>From:</b> <%= ride_data.pickup_location %></p>
          <p class="mb-1"><b>To:</b> <%= ride_data.destination %></p>
          <p class="mb-1">
            <b>Date:</b> <%= ride_data.departure_date_time.toLocaleString() %>
          </p>
          <p class="mb-1"><b>Seats:</b> <%= ride_data.seat %></p>
          <p class="mb-1"><b>Car Type:</b> <%= ride_data.car_type %></p>
          <p class="mb-2"><b>Price:</b> ₹<%= ride_data.price %> / seat</p>
          <% if(!currUser || currUser.role === "passenger"){ %>
<a href="/booking/<%= ride_data._id %>" class="btn btn-dark mt-auto">Book Now</a>
<% } %>
        </div>
      </div>
<% } %>
    <% } %>

  </div>
</div>