<% layout("/layouts/boilerplate.ejs") %>

<div class="container mt-4">
  <div class="row">

    <% for (let ride_data of specfic_ride) { %>

      <div class="col-md-4 mb-4">
        <div class="card shadow-sm h-100 p-3">

          <h5 class="border-bottom pb-2">
            <b>Driver:</b> <%= ride_data.driver.username %>
          </h5>

          <p class="mb-1"><b>From:</b> <%= ride_data.pickup_location %></p>
          <p class="mb-1"><b>To:</b> <%= ride_data.destination %></p>
          
          <p class="mb-1">
            <b>Date:</b> 
            <%= new Date(ride_data.departure_date_time).toLocaleString() %>
          </p>

          <p class="mb-1"><b>Seats:</b> <%= ride_data.seat %></p>
          <p class="mb-1"><b>Car Type:</b> <%= ride_data.car_type %></p>
          <p class="mb-2"><b>Price:</b> ₹<%= ride_data.price %> / seat</p>
          

          <div>
  <a href="/ridestatus/edit/<%= ride_data._id %>" class="btn btn-dark btn-sm">
    Edit
  </a>

  <form
    action="/ridestatus/delete/<%= ride_data._id %>?_method=DELETE"
    method="POST"
    style="display:inline"
    onsubmit="return confirm('Are you want to delete this message?')"
  >
    <button class="btn btn-dark btn-sm">Delete</button>
  </form>
</div>

        </div>
      </div>

    <% } %>

  </div>
</div>